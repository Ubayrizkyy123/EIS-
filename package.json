    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
