# Salin file ini menjadi .env lalu isi nilainya.
# Generate AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Connection string aplikasi (boleh memakai pooled connection Neon).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# Opsional: connection string langsung untuk migrasi Prisma.
# Jika kosong, prisma7.config.ts menghapus "-pooler" dari host DATABASE_URL.
# DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# Opsional untuk seed demo. Jika tidak diatur, password default adalah Password123!.
# Jangan gunakan password default di production.
# SEED_PASSWORD="ganti-password-demo"

# Opsional: Google OAuth
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
